# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า:  cp .env.example .env
# แก้ค่าแล้วต้องรีสตาร์ทบอทหนึ่งครั้ง (บน Railway กด Redeploy)

# ======================================================================
# ตัวตนของบอท
# ======================================================================

# ชื่อบอท — ให้ตรงกับชื่อ LINE Official Account เช่น น้องมะลิ / พี่หมี / MayBot
BOT_NAME=น้องมะลิ

# คำแทนตัวเอง — ไม่ต้องตั้งก็ได้ ระบบเดาจากชื่อให้
#   "น้องมะลิ" → "น้อง"  ·  "พี่หมี" → "พี่"  ·  ชื่ออื่น → เรียกชื่อตัวเองเต็ม
# BOT_SELF=น้อง

# คำลงท้าย: ปล่อยว่าง = ค่ะ/นะคะ · ใส่ "ชาย" = ครับ ทั้งบอท
# BOT_POLITE=ชาย

# อิโมจิประจำตัว (ค่าเริ่มต้น 💙)
# BOT_EMOJI=🌼

# ข้อความทักทายตอนมีคนแอดเพื่อน (ไม่ตั้ง = ทักแบบมาตรฐานด้วยชื่อบอท)
# BOT_GREETING=สวัสดีค่ะ ร้านบ้านมะลิยินดีต้อนรับ พิมพ์ถามเมนูหรือสั่งของได้เลยนะคะ

# ======================================================================
# หน้าที่ของบอท — เขียนในไฟล์ brief.txt (ดูตัวอย่าง brief.example.txt)
#   ตั้ง BOT_BRIEF ด้านล่างไว้ = ใช้แทน brief.txt (เหมาะกับคำสั่งสั้นบรรทัดเดียว)
# ======================================================================
# BOT_BRIEF=คุณคือเลขาส่วนตัวของเจ้าของ ช่วยจดงาน เตือนเรื่องที่ต้องทำ และสรุปให้เมื่อถูกขอ
# BOT_BRIEF_FILE=./brief.txt

# --- LINE Messaging API (developers.line.biz) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- AI ผ่าน OpenRouter (openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# AI_MODEL=google/gemini-2.5-flash       # โมเดลตอบแชท
# VISION_MODEL=google/gemini-2.5-flash   # โมเดลอ่านรูป/เสียง/วิดีโอ

# --- กันค่า AI บาน: จำนวนข้อความสูงสุดต่อคนต่อวัน (0 = ไม่จำกัด) ---
# DAILY_LIMIT=100

# --- สร้างภาพใหม่ผ่าน OpenRouter ใช้คีย์เดียวกับแชท ---
# IMAGE_GENERATION_ENABLED=true
# IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# IMAGE_DAILY_LIMIT=3                  # จำนวนครั้งต่อคนต่อวัน (รวมครั้งที่ API ล้มเหลว)
# IMAGE_GLOBAL_DAILY_LIMIT=30          # จำนวนครั้งรวมทั้งบอตต่อวัน
# IMAGE_DIR=/data/generated-images    # ค่าเริ่มต้นอยู่ข้าง DB_PATH; ภาพหมดอายุใน 24 ชั่วโมง
# APP_URL=https://xxx.up.railway.app   # หรือใช้ RAILWAY_PUBLIC_DOMAIN ที่ Railway ตั้งให้

# --- รหัสดาวน์โหลดไฟล์สำรอง /admin/backup (ตั้งให้ยาวๆ เดาไม่ได้ — ใครมีรหัสนี้โหลดแชททั้งหมดได้) ---
ADMIN_KEY=

# --- อื่นๆ ---
# PORT=3000
# DB_PATH=./chatbot.db                  # บน Railway ใช้ /data/chatbot.db (volume)
# APP_URL=https://xxx.up.railway.app    # ที่อยู่จริงของบอท — ใช้ตอน bin/backup-db.sh ดึงไฟล์สำรอง
TZ=Asia/Bangkok                         # สำคัญ! ให้บอทรู้วันเวลาแบบไทย
